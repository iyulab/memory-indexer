<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- NU5104: MCP prerelease dependency, CS/IDE: existing code style suppressions, CA1720: intentional domain names (Short/Long/Object) in SPO triples and memory tiers -->
    <NoWarn>$(NoWarn);NU5104;CS9107;IDE0011;IDE0040;IDE0044;CA1720</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Product>Memory Indexer</Product>
    <Copyright>Copyright (c) 2025 iyulab</Copyright>
    <RepositoryUrl>https://github.com/iyulab/memory-indexer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.13.2</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- PackageReadmeFile is set per project where README exists -->
    <IsPackable>false</IsPackable> <!-- Default: only SDK is packable -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
