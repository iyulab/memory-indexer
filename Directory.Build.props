<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CS/IDE: existing code style suppressions, CA1720: intentional domain names (Short/Long/Object) in SPO triples and memory tiers -->
    <NoWarn>$(NoWarn);CS9107;IDE0011;IDE0040;IDE0044;CA1720</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Product>Memory Indexer</Product>
    <Copyright>Copyright (c) 2025 iyulab</Copyright>
    <RepositoryUrl>https://github.com/iyulab/memory-indexer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.19.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- PackageReadmeFile is set per project where README exists -->
    <IsPackable>false</IsPackable> <!-- Default: only SDK is packable -->
  </PropertyGroup>

  <!-- Ship the XML documentation with the package (2026-09-17, umbrella check-xml-doc-file): without this the nupkg
       held only the dll and none of the /// docs reached a consumer. CS1591 is muted as elsewhere in the ecosystem;
       the doc file is the goal, not a warning per member. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\src\')) OR $(MSBuildProjectDirectory.Contains('/src/'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Source Link + Symbol Package -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Local NuGet package source for development (see ironhive-umbrella/CLAUDE.md) -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../../local-packages')">
    <RestoreAdditionalProjectSources>
      $(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)../../local-packages
    </RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
