<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- MCP SDK -->
    <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <!-- Microsoft Extensions (.NET 10) -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <!-- Vector Data -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.11.0" />
    <!-- Database -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Explicit lift: Microsoft.Data.Sqlite 10.0.8 pulls SQLitePCLRaw 2.1.11
         (NU1903 high, GHSA-2m69-gcr7-jv3q); upstream 2.1.12 stable landed 2026-07-09.
         Direct reference in MemoryIndexer.Sdk so the >= 2.1.12 floor propagates to consumers. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Numerics -->
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.14" />
    <!-- Build -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <!-- Testing -->
    <!-- xUnit v3 / Microsoft.Testing.Platform -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Iyu.Conventions.Testing.Snippets" Version="0.13.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.13.0" />
    <!-- Real-connector contract run of VectorStoreMemoryStore (test-only). The maintained connectors are the .NET
         Community Toolkit ones (Microsoft.SemanticKernel.Connectors.* 1.74 previews are built against VectorData 10.1 and
         fail with TypeLoadException on 10.6+). Never reaches a package. -->
    <PackageVersion Include="CommunityToolkit.VectorData.Qdrant" Version="1.0.1" />
    <PackageVersion Include="Testcontainers.Qdrant" Version="4.16.0" />
    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- LMSupply (iyulab-rnd open source) -->
    <PackageVersion Include="LMSupply.Embedder" Version="0.137.0" />
    <PackageVersion Include="LMSupply.Generator" Version="0.137.0" />
    <!-- Environment -->
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <!-- OpenAI -->
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.14" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    <!-- OpenTelemetry Observability -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
  </ItemGroup>
</Project>