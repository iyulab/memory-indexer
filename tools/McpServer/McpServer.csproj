<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Standalone MCP server console application for Memory Indexer</Description>
    <PackageTags>mcp;memory;console;server</PackageTags>
    <AssemblyName>memory-indexer</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MemoryIndexer.Sdk\MemoryIndexer.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core Web SDK includes all hosting/config dependencies -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- transitive Microsoft.OpenApi 2.4.1 is vulnerable (GHSA-v5pm-xwqc-g5wc); promote to patched pin -->
    <PackageReference Include="Microsoft.OpenApi" />
    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
