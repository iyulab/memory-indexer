{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "MemoryIndexer": "Information",
      "Microsoft": "Warning"
    }
  },
  "MemoryIndexer": {
    "Storage": {
      "Type": "SqliteVec",
      "ConnectionString": "memories.db"
    },
    "Embedding": {
      "Provider": "Custom",
      "Model": "default",
      "Dimensions": 1024
    },
    "Search": {
      "DefaultLimit": 10,
      "MaxLimit": 50
    }
  }
}
