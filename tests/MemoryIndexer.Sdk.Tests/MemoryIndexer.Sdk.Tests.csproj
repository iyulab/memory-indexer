<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

  </PropertyGroup>

  <!-- SKIP_ONNX_TESTS removed 2026-08-24 (cycle-301): ONNX Runtime + LMSupply.Embedder run fine on
       .NET 10 in practice. The flag's real, non-obvious effect was hiding this project from the
       compiler entirely — 17 dormant CA analyzer violations (CA1826/CA1305/CA1859/CA1822/CA2016)
       had accumulated in files that literally never compiled while the flag was on. All fixed;
       this project now always compiles as part of the normal build, so future regressions of that
       kind are caught at compile time instead of silently rotting behind the flag again.
       Separately, the "fast" (multilingual-e5-small) catalog default initially measured lower than
       the old "all-MiniLM-L6-v2" model on 8 fixed semantic-quality thresholds. An E5
       instruction-prefix ("query: "/"passage: ") fix was hypothesized and empirically disproven
       (prefix shifted similarity by <0.01, not the cause). cycle-303 root-caused and fixed 7 of the
       8: 3 via model-agnostic redesign (relative ordering / self-referential query instead of fixed
       cosine thresholds), 2 via a "fast"-specific similarity-hub finding (some short sentences score
       anomalously high average similarity across unrelated queries — recall@K widening plus a
       grounded, documented threshold recalibration), and 2 via recall@K widening alone (the correct
       memory was already being fetched, just past the old cutoff). The 1 remaining Skip
       (ComprehensiveQualityComparison_BaselineVsEnhanced) traces to a real, deterministic bug in
       QueryExpander's SynonymMap ("code"->"program" breaks the "code reviews" compound noun),
       production code out of scope for a test-only cycle — pointer:
       claudedocs/memory-indexer/issues/ISSUE-memory-indexer-20260824-010000-heavy-quality-thresholds-need-recalibration.md.
       That one test carries the Heavy trait, so CI's Category!=Heavy filter is unaffected either way.
       To opt out of building this project entirely (e.g. a machine without ONNX Runtime support),
       SKIP_ONNX_TESTS can still be set externally via `-p:DefineConstants=SKIP_ONNX_TESTS` — no
       PropertyGroup here defines it by default anymore. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\MemoryIndexer.Sdk\MemoryIndexer.Sdk.csproj" />
    <ProjectReference Include="..\..\tools\McpServer\McpServer.csproj" />
    <ProjectReference Include="..\MemoryIndexer.Tests\MemoryIndexer.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- LMSupply embedding for integration tests (iyulab open source) -->
    <PackageReference Include="LMSupply.Embedder" />
    <!-- transitive Microsoft.OpenApi 2.4.1 is vulnerable (GHSA-v5pm-xwqc-g5wc); promote to patched pin -->
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

</Project>
