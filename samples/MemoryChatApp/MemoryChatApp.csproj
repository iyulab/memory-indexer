<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- SPA Proxy Configuration -->
    <SpaRoot>frontend\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:3000</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MemoryIndexer.Sdk\MemoryIndexer.Sdk.csproj" />
    <ProjectReference Include="..\..\tools\SharedLib\SharedLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
  </ItemGroup>

  <!-- Ensure SPA assets are included in publish -->
  <ItemGroup>
    <DistFiles Include="$(SpaRoot)dist\**" />
    <Content Include="@(DistFiles)" CopyToPublishDirectory="PreserveNewest" LinkBase="wwwroot" Condition="Exists('$(SpaRoot)dist')" />
  </ItemGroup>

</Project>
