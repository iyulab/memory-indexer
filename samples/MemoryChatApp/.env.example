# GpuStack OpenAI-compatible API configuration
# Copy to solution root (.env) and fill in your values

# Required for chat LLM
GPUSTACK_URL=http://your-gpustack-server/v1
GPUSTACK_APIKEY=your-api-key-here
GPUSTACK_MODEL=gpt-oss-20b

# Optional: If not set, uses LMSupply Local embedding (bge-large-en-v1.5)
# GPUSTACK_EMBED_MODEL=bge-m3
